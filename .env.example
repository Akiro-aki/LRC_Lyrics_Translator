# Copy to .env and adjust. All values are optional; sensible defaults exist.

# ---- Translation backend (google | libretranslate | openai | gemini) ----
# google: free endpoint, no key required (default)
# libretranslate: self-hosted or libretranslate.com (API key optional)
# openai: any OpenAI-compatible chat API
# gemini: Google Gemini API, API key required
TRANSLATOR_BACKEND=google

# LibreTranslate
LIBRETRANSLATE_URL=https://libretranslate.com
LIBRETRANSLATE_API_KEY=

# OpenAI-compatible endpoint
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Gemini (text translation via the Gemini API)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest
# Note: *live-translate* models are speech-to-speech only (Live API, audio in)
# and cannot translate text. Override GEMINI_MODEL only with a text model.
GEMINI_TPM=20000
GEMINI_RPM=28
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# ---- Lyrics source (lrclib | netease | qqmusic | auto) ----
# lrclib:   LRCLIB (lrclib.net) — free, no key, best for Western music
# netease:  NetEase Cloud Music (music.163.com) — free, no key, strong for CJK music
# qqmusic:  QQ Music (y.qq.com) — free, no key, strongest for Chinese/K-pop/J-pop
# auto:     ask every provider and keep the best verified match
LYRICS_PROVIDER=lrclib

# Reject external matches below this confidence (0-1). Every candidate is
# checked against the file's title/artist/duration before its lyrics are used.
# LYRICS_MIN_CONFIDENCE=0.6

# Override API bases (usually not needed)
# LRCLIB_URL=https://lrclib.net
# NETEASE_URL=https://music.163.com
# QQMUSIC_URL=https://c.y.qq.com
# QQMUSIC_SEARCH_URL=https://u.y.qq.com/cgi-bin/musicu.fcg

# ---- Misc ----
# Location for the lyrics response cache
# CACHE_DIR=~/.cache/audio2lrc

# ---- TUI (audio2lrc-tui) ----
# Theme: opencode (default) | system (adapts to terminal) | one-dark |
# tokyonight | catppuccin | nord | gruvbox
# A2LRC_THEME=opencode
