# Copy to .env and adjust. All values are optional; sensible defaults exist.

# ---- Translation backend (google | libretranslate | openai) ----
# google: free endpoint, no key required (default)
# libretranslate: self-hosted or libretranslate.com (API key optional)
# openai: any OpenAI-compatible chat API
TRANSLATOR_BACKEND=google

# LibreTranslate
LIBRETRANSLATE_URL=https://libretranslate.com
LIBRETRANSLATE_API_KEY=

# OpenAI-compatible endpoint
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# ---- Lyrics source ----
# Override the LRCLIB API base (usually not needed)
# LRCLIB_URL=https://lrclib.net

# ---- Misc ----
# Location for the LRCLIB response cache
# CACHE_DIR=~/.cache/audio2lrc